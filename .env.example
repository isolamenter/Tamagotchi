# === 飞书自建应用 ===
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# 事件订阅 → Verification Token。【必填】缺失会启动失败；
# 留空会让公网 webhook 无鉴权，因此不再允许空值。
FEISHU_VERIFICATION_TOKEN=
# 如果在飞书后台开了"加密策略"，把 Encrypt Key 填这里；否则留空
FEISHU_ENCRYPT_KEY=

# === LLM 模型 ===
# chat 模型
CHAT_MODEL=gpt-4o-mini
# 长期记忆 RAG 用的 embedding 模型
EMBED_MODEL=text-embedding-3-small
# 梦境插图用的图像模型（如 gemini-3.1-flash-image-preview）；留空 = 关闭梦境插图
IMAGE_MODEL=

# 后端切换：openai = 走 OpenAI 兼容接口；gemini = 走 google-genai 原生 SDK
# 两个后端复用上面同一组 CHAT_MODEL / EMBED_MODEL / IMAGE_MODEL
LLM_PROVIDER=openai

# --- openai 兼容后端（LLM_PROVIDER=openai）---
# 任意 OpenAI 兼容服务（官方 OpenAI、NewApi、本地网关等）；base_url 末尾通常需带 /v1
OPENAI_BASE_URL=https://your-openai-compatible.example.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- gemini 原生后端（LLM_PROVIDER=gemini）---
# 仅 LLM_PROVIDER=gemini 时使用；base url 留空 = Google 官方端点
# 注意：SDK 会自动拼 /v1beta/models/...，自建/代理端点【不要】带 /v1 后缀（否则 404）
GEMINI_BASE_URL=
GEMINI_API_KEY=

# === 服务 ===
PORT=8000

# === GM Web API ===
# 可选。用于 /gm/* 调试接口；不填时复用 FEISHU_VERIFICATION_TOKEN。
GM_TOKEN=
