# === 飞书自建应用 ===
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# 事件订阅 → Verification Token，留空则跳过校验（不推荐）
FEISHU_VERIFICATION_TOKEN=
# 如果在飞书后台开了"加密策略"，把 Encrypt Key 填这里；否则留空
FEISHU_ENCRYPT_KEY=

# === NewApi (OpenAI 兼容) ===
# 注意 base_url 末尾通常需要带 /v1
OPENAI_BASE_URL=https://your-newapi.example.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# 你 NewApi 上挂的模型名
MODEL_NAME=gpt-4o-mini
# 长期记忆 RAG 用的 embedding 模型；默认是 OpenAI 兼容的 text-embedding-3-small
EMBED_MODEL=text-embedding-3-small
# 梦境插图用的图像模型（如 gemini-3.1-flash-image-preview）；留空 = 关闭梦境插图
IMAGE_MODEL=

# === 服务 ===
PORT=8000

# === GM Web API ===
# 可选。用于 /gm/* 调试接口；不填时复用 FEISHU_VERIFICATION_TOKEN。
GM_TOKEN=
