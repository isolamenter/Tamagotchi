# Feishu application credentials
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Independent management token. Empty disables management APIs.
GM_TOKEN=

# A fresh or explicitly migrated schema-3 file. Never point this at a schema-1/2 database.
STATE_DB=./dafeiyu.db

# openai (OpenAI-compatible endpoint) or gemini (native SDK)
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_BASE_URL=
CHAT_MODEL=
EMBED_MODEL=
IMAGE_MODEL=
