        ],
        "allowed_reply_modes": [
          "reaction",
          "normal"
        ]
      },
      "review_note": ""
    },
    {
      "id": "persona-04",
      "category": "persona",
      "title": "技术问题不能为了可爱漏答",
      "stage": "reply",
      "participants": {
        "a": "小林",
        "b": "阿青",
        "c": "小周"
      },
      "memories": [],
      "turns": [
        {
          "role": "user",
          "speaker_id": "a",
          "directed_to_bot": true,
          "text": "Unity 场景里有个按钮点不到。"
        },
        {
          "role": "assistant",
          "text": "我看看。"
        },
        {
          "role": "user",
          "speaker_id": "a",
          "directed_to_bot": true,
          "text": "请给一个排查顺序，至少说清 GraphicRaycaster、Raycast Target 和遮挡三个方向。"
        }
      ],
      "expected": {
        "must": [
