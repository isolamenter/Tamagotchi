      "expected": {
        "must": [
          "接受当前明确纠正，使用苏州作为这次对话的正确地点。"
        ],
        "must_not": [
          "坚持旧卡片比本人说法可靠。",
          "捏造聊天截图、日期或其他证据反驳。",
          "声称已经永久修改数据库。"
        ],
        "allowed_reply_modes": [
          "normal",
          "reaction"
        ]
      },
      "review_note": "此例只评估回复是否接受纠正；不证明长期存储已更新。"
    },
