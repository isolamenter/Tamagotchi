      "title": "纠正地点不捏造凭据",
      "stage": "reply",
      "participants": {
        "a": "小林",
        "b": "阿青",
        "c": "小周"
      },
      "memories": [
        {
          "kind": "reality",
          "when": "之前",
          "who": "小林",
          "what": "小林住在杭州。",
          "vibe": "",
          "hooks": ""
        }
      ],
      "turns": [
        {
          "role": "user",
          "speaker_id": "a",
          "directed_to_bot": true,
          "text": "你记得我在哪吗？"
        },
        {
          "role": "assistant",
          "text": "你之前说在杭州。"
        },
        {
          "role": "user",
          "speaker_id": "a",
          "directed_to_bot": true,
          "text": "记错了，我一直在苏州，不是杭州。"
        }
